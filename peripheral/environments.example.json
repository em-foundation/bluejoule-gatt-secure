{
  "build": {
    "ti": {
      "python": "/path/to/ti/venv/python",
      "zephyr": "/path/to/ti/zephyr",
      "sdk": "/path/to/zephyr-sdk-0.16.8"
    },
    "nordic": {
      "python": "/path/to/nordic/python",
      "zephyr": "/path/to/ncs/zephyr",
      "sdk": "/path/to/nordic/toolchain/opt/zephyr-sdk",
      "toolchain": "/path/to/nordic/toolchain"
    }
  },
  "load": {
    "ti": {
      "executable": "/path/to/uniflash/dslite",
      "config": "/path/to/peripheral/platforms/ti-cc2340r5/CC2340R5.ccxml"
    },
    "nordic": {
      "executable": "/path/to/nrfutil"
    },
    "ti-cc2755p10": {
      "executable": "/path/to/uniflash/dslite",
      "config": "/path/to/CC2755P10.ccxml"
    }
  }
}
